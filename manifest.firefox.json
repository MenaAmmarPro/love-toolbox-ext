{
  "manifest_version": 3,
  "name": "Love Toolbox",
  "version": "1.0.0",
  "description": "A little toolbox for two — calculator, quick notes, unit converter and text tools.",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_title": "Love Toolbox",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "love-toolbox-ext@menaammarpro.github.io",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
